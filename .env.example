# Piyade RP Bot 1 Ortam Değişkenleri Şablonu
# Bu dosyayı '.env' olarak kopyalayıp kendi token ve anahtarlarınızı girin.

# Botun Discord Tokeni (Zorunlu)
SERVER_TOKEN=your_bot_token_here

# Sunucu ID'si (Varsayılan: 1529545898294509589)
GUILD_ID=1529545898294509589

# ER:LC API Anahtarı (Gerekirse)
ERLC_API_KEY=

# Roblox API Anahtarı (Gerekirse)
ROBLOX_API_KEY=

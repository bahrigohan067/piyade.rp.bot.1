# Piyade RP Bot 1 - Ortam Değişkenleri Şablonu
# Bu dosyayı '.env' olarak kopyalayıp değerleri giriniz.

# 1. Discord Bot Tokeni (Zorunlu)
SERVER_TOKEN=your_bot_token_here

# 2. ER:LC Private Server API Anahtarı (Zorunlu - Oyun Sunucusu İletişimi İçin)
ERLC_API_KEY=your_erlc_api_key_here

# 3. Discord Sunucu ID'si (Piyade RP: 1529545898294509589)
GUILD_ID=1529545898294509589

# 4. Sunucu Kodu (İsteğe bağlı)
ERLC_SUNUCU_KODU=piyade
